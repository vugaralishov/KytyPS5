{
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/_Build/vscode-clang",
    "cmake.generator": "Ninja",
    "cmake.useVsDeveloperEnvironment": "always",
    "cmake.environment": {
        "CC": "clang-cl",
        "CXX": "clang-cl"
    },
    // Set QT_ROOT_DIR to your Qt kit, e.g. C:/Qt/6.10.3/msvc2022_64 (CI builds with Qt 6.10.3).
    "cmake.configureSettings": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_PREFIX_PATH": "${env:QT_ROOT_DIR}"
    },
    "C_Cpp.default.intelliSenseMode": "windows-clang-x64",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/_Build/vscode-clang/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++20"
}
