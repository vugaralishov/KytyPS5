<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ConfigurationEditDialog</class>
 <widget class="QDialog" name="ConfigurationEditDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>900</width>
    <height>620</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Settings</string>
  </property>
  <property name="locale">
   <locale language="English" country="UnitedStates"/>
  </property>
  <layout class="QGridLayout" name="gridLayout">
   <property name="horizontalSpacing">
    <number>8</number>
   </property>
   <property name="verticalSpacing">
    <number>8</number>
   </property>
   <item row="0" column="0" colspan="2">
    <layout class="QGridLayout" name="sectionsLayout" columnstretch="1,1">
     <property name="horizontalSpacing">
      <number>8</number>
     </property>
     <property name="verticalSpacing">
      <number>8</number>
     </property>
     <item row="0" column="0">
      <widget class="QGroupBox" name="user_profile_group">
       <property name="title">
        <string>User profile</string>
       </property>
       <layout class="QFormLayout" name="userProfileLayout">
        <property name="fieldGrowthPolicy">
         <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
        </property>
        <item row="0" column="0">
         <widget class="QLabel" name="label_user_name">
          <property name="text"><string>User name:</string></property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="MandatoryLineEdit" name="lineEdit_user_name">
          <property name="toolTip"><string>Name that games show for the signed-in user (1-16 characters).</string></property>
          <property name="clearButtonEnabled"><bool>true</bool></property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="label_user_id">
          <property name="text"><string>User ID:</string></property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QSpinBox" name="spinBox_user_id">
          <property name="toolTip"><string>ID of the signed-in user. Trophies and some saves are stored per ID, so changing it hides earlier ones. Leave at 1000.</string></property>
          <property name="maximum"><number>2147483647</number></property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="label_console_language">
          <property name="text"><string>Console language:</string></property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QComboBox" name="comboBox_console_language">
          <property name="toolTip"><string>System language reported to games and used for trophy text. A game only switches if it includes that language.</string></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QGroupBox" name="audio_group">
       <property name="title"><string>Audio</string></property>
       <layout class="QFormLayout" name="audioLayout">
        <property name="fieldGrowthPolicy">
         <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
        </property>
        <item row="0" column="0">
         <widget class="QLabel" name="label_audio_input_device">
          <property name="text"><string>Microphone:</string></property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="comboBox_audio_input_device"/>
        </item>
       </layout>
      </widget>
     </item>
     <item row="0" column="1" rowspan="3">
      <widget class="QGroupBox" name="graphics_group">
       <property name="title">
        <string>Graphics &amp;&amp; display</string>
       </property>
       <layout class="QFormLayout" name="graphicsLayout">
        <property name="fieldGrowthPolicy">
         <enum>QFormLayout::AllNonFixedFieldsGrow</enum>
        </property>
        <item row="0" column="0">
         <widget class="QLabel" name="label_screen_resolution">
          <property name="text"><string>Screen resolution:</string></property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QComboBox" name="comboBox_screen_resolution">
          <property name="toolTip"><string>Size of the game window. It does not change the resolution the game renders at; 3840x2160 also tells games that 4K output is available.</string></property>
         </widget>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="label_present_mode">
          <property name="text"><string>Present mode:</string></property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QComboBox" name="comboBox_present_mode">
          <property name="toolTip"><string>How frames reach the screen. Mailbox: no tearing, low latency (recommended). Fifo: classic V-Sync. Immediate: lowest latency but may tear.</string></property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="label_vblank_frequency">
          <property name="text"><string>Vblank frequency:</string></property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QSpinBox" name="spinBox_vblank_frequency">
          <property name="toolTip"><string>Refresh rate of the emulated display. Keep 60. 120 or more also unlocks 120 Hz modes in games that have them.</string></property>
          <property name="minimum"><number>30</number></property>
          <property name="maximum"><number>360</number></property>
          <property name="value"><number>60</number></property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="label_shader_optimization">
          <property name="text"><string>Shader optimization:</string></property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QComboBox" name="comboBox_shader_optimization_type">
          <property name="toolTip"><string>Currently not used by the emulator.</string></property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QLabel" name="label_gpu">
          <property name="text"><string>GPU:</string></property>
         </widget>
        </item>
        <item row="4" column="1">
         <widget class="QComboBox" name="comboBox_gpu">
          <property name="toolTip"><string>Graphics card used by the emulator. Auto prefers a dedicated GPU.</string></property>
         </widget>
        </item>
        <item row="5" column="1">
         <widget class="QCheckBox" name="checkBox_fullscreen">
          <property name="toolTip"><string>Start in borderless fullscreen. F11 or Alt+Enter toggles it in game.</string></property>
          <property name="text"><string>Fullscreen</string></property>
         </widget>
        </item>
        <item row="6" column="1">
         <widget class="QCheckBox" name="checkBox_readback">
          <property name="toolTip"><string>Copy images rendered by the GPU back to game memory. Can fix missing or wrong content in some games; costs performance.</string></property>
          <property name="text"><string>Enable readback</string></property>
         </widget>
        </item>
        <item row="7" column="1">
         <widget class="QCheckBox" name="checkBox_tessellation">
          <property name="toolTip"><string>Draw tessellated geometry (terrain, detailed models). When off, such draws are skipped. Experimental: may crash.</string></property>
          <property name="text"><string>Enable tessellation support (experimental)</string></property>
         </widget>
        </item>
        <item row="8" column="1">
         <widget class="QCheckBox" name="checkBox_hide_cursor">
          <property name="toolTip"><string>Hide the mouse cursor after 2 seconds without movement.</string></property>
          <property name="text"><string>Auto-hide cursor</string></property>
         </widget>
        </item>
        <item row="9" column="1">
         <widget class="QCheckBox" name="checkBox_skip_notice_screen">
          <property name="toolTip"><string>Ask games to skip startup logos and notices. Only some games honor it.</string></property>
          <property name="text"><string>Skip boot logos</string></property>
         </widget>
        </item>
        <item row="10" column="1">
         <widget class="QCheckBox" name="checkBox_sync_raw_image_buffers">
          <property name="toolTip"><string>Synchronize textures that are also read as raw memory. Can fix missing textures or wrong transparency; may reduce performance.</string></property>
          <property name="text"><string>Accurate texture synchronization</string></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QGroupBox" name="notifications_group">
       <property name="title"><string>Notifications</string></property>
       <layout class="QVBoxLayout" name="notificationsLayout">
        <item>
         <widget class="QCheckBox" name="checkBox_trophy_notifications">
          <property name="toolTip"><string>Show a popup and play a sound when a trophy unlocks. Trophies are recorded either way.</string></property>
          <property name="text"><string>Enable trophy notifications</string></property>
          <property name="checked"><bool>true</bool></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item row="4" column="0" colspan="2">
      <widget class="QGroupBox" name="debug_group">
       <property name="title">
        <string>Debugging &amp;&amp; logs</string>
       </property>
       <layout class="QGridLayout" name="debugLayout" columnstretch="0,1,0,1">
        <property name="horizontalSpacing"><number>8</number></property>
        <property name="verticalSpacing"><number>6</number></property>
        <item row="0" column="0" colspan="2">
         <widget class="QCheckBox" name="checkBox_vulkan_validation">
          <property name="toolTip"><string>Developers: check every Vulkan call (needs the Vulkan SDK). Very slow.</string></property>
          <property name="text"><string>Vulkan validation</string></property>
          <property name="checked"><bool>true</bool></property>
         </widget>
        </item>
        <item row="0" column="2" colspan="2">
         <widget class="QCheckBox" name="checkBox_shader_validation">
          <property name="toolTip"><string>Developers: validate every recompiled shader. The emulator stops if one fails, so leave it off to play.</string></property>
          <property name="text"><string>Shader validation</string></property>
          <property name="checked"><bool>true</bool></property>
         </widget>
        </item>
        <item row="1" column="0" colspan="2">
         <widget class="QCheckBox" name="checkBox_renderdoc_capture">
          <property name="toolTip"><string>Developers: load RenderDoc (must be installed); press F1 in game to capture a frame.</string></property>
          <property name="text"><string>RenderDoc capture</string></property>
         </widget>
        </item>
        <item row="1" column="2" colspan="2">
         <widget class="QCheckBox" name="checkBox_cmd_dump">
          <property name="toolTip"><string>Developers: write every GPU command buffer to text files. Slow and fills the disk quickly.</string></property>
          <property name="text"><string>Command buffer dump</string></property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="label_shader_log_direction">
          <property name="text"><string>Shader logging:</string></property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="QComboBox" name="comboBox_shader_log_direction">
          <property name="toolTip"><string>Developers: log recompiled shaders. Output goes to the Printf log, so Printf output must not be Silent. Slows shader compilation.</string></property>
         </widget>
        </item>
        <item row="2" column="2">
         <widget class="QLabel" name="label_shader_log_folder">
          <property name="text"><string>Shader log folder:</string></property>
         </widget>
        </item>
        <item row="2" column="3">
         <widget class="MandatoryLineEdit" name="lineEdit_shader_log_folder">
          <property name="toolTip"><string>Folder for shader binary dumps. Only used with the emulator's --graphics-debug-dump option.</string></property>
          <property name="clearButtonEnabled"><bool>true</bool></property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="label_printf_direction">
          <property name="text"><string>Printf output:</string></property>
         </widget>
        </item>
        <item row="3" column="1">
         <widget class="QComboBox" name="comboBox_printf_direction">
          <property name="toolTip"><string>Where the emulator log goes: nowhere (fastest), a console window, or a file. Use File when reporting a bug.</string></property>
         </widget>
        </item>
        <item row="3" column="2">
         <widget class="QLabel" name="label_printf_file">
          <property name="text"><string>Printf output file:</string></property>
         </widget>
        </item>
        <item row="3" column="3">
         <widget class="MandatoryLineEdit" name="lineEdit_printf_file">
          <property name="toolTip"><string>Log file name, relative to the emulator folder.</string></property>
          <property name="clearButtonEnabled"><bool>true</bool></property>
         </widget>
        </item>
        <item row="4" column="0">
         <widget class="QCheckBox" name="checkBox_profiler">
          <property name="toolTip"><string>Developers: start the Tracy profiler (connect to 127.0.0.1). Slows the emulator.</string></property>
          <property name="text"><string>Tracy profiler</string></property>
         </widget>
        </item>
        <item row="4" column="2">
         <widget class="QLabel" name="label_cmd_dump_folder">
          <property name="text"><string>Command buffer folder:</string></property>
         </widget>
        </item>
        <item row="4" column="3">
         <widget class="MandatoryLineEdit" name="lineEdit_cmd_dump_folder">
          <property name="toolTip"><string>Folder for command buffer dumps, relative to the emulator folder.</string></property>
          <property name="clearButtonEnabled"><bool>true</bool></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QGroupBox" name="compatibility_group">
       <property name="title">
        <string>Compatibility</string>
       </property>
       <layout class="QVBoxLayout" name="compatibilityLayout">
        <item>
         <widget class="QCheckBox" name="checkBox_amd_cpu">
          <property name="toolTip"><string>Rewrite AMD-only CPU instructions the host processor lacks. Turn on if a game crashes with an illegal instruction, mainly on Intel CPUs.</string></property>
          <property name="text"><string>AMD CPU patch (experimental)</string></property>
         </widget>
        </item>
        <item>
         <widget class="QCheckBox" name="checkBox_red_zone_protection">
          <property name="toolTip"><string>Protect stack data that Windows exception handling can overwrite. Turn on only for games that crash randomly on Windows; loads slower.</string></property>
          <property name="text"><string>Windows SysV red zone crash protection (experimental)</string></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
    </layout>
   </item>
   <item row="1" column="1">
    <widget class="QGroupBox" name="controller_group">
     <property name="title"><string>Controller</string></property>
     <layout class="QFormLayout" name="controllerLayout">
      <property name="fieldGrowthPolicy"><enum>QFormLayout::AllNonFixedFieldsGrow</enum></property>
      <item row="0" column="0">
       <widget class="QLabel" name="label_controller_color">
        <property name="text"><string>DualSense lightbar:</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <layout class="QHBoxLayout" name="controllerColorLayout">
        <item>
         <widget class="QPushButton" name="button_controller_color">
          <property name="toolTip"><string>Pick a fixed lightbar color. It overrides the color the game sets; Bluetooth controllers can take a few seconds to update.</string></property>
          <property name="text"><string>Custom</string></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="button_controller_color_reset">
          <property name="toolTip"><string>Let the game control the lightbar color.</string></property>
          <property name="text"><string>Default</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_controller_vibration">
        <property name="text"><string>Vibration intensity:</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <layout class="QHBoxLayout" name="controllerVibrationLayout">
        <item>
         <widget class="QSlider" name="slider_controller_vibration">
          <property name="toolTip"><string>Strength of DualSense vibration over USB and Bluetooth. 0% turns it off.</string></property>
          <property name="maximum"><number>100</number></property>
          <property name="value"><number>100</number></property>
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_controller_vibration_value">
          <property name="minimumSize"><size><width>40</width><height>0</height></size></property>
          <property name="text"><string>100%</string></property>
         </widget>
        </item>
       </layout>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_controller_volume">
        <property name="text"><string>Speaker volume:</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <layout class="QHBoxLayout" name="controllerVolumeLayout">
        <item>
         <widget class="QSlider" name="slider_controller_volume">
          <property name="toolTip"><string>DualSense speaker volume. 50% is the normal level; 100% adds about 6 dB.</string></property>
          <property name="maximum"><number>100</number></property>
          <property name="value"><number>50</number></property>
          <property name="orientation"><enum>Qt::Horizontal</enum></property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="label_controller_volume_value">
          <property name="minimumSize"><size><width>40</width><height>0</height></size></property>
          <property name="text"><string>50%</string></property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
   <item row="2" column="0" colspan="2">
    <layout class="QHBoxLayout" name="buttonLayout">
     <item>
     <widget class="QPushButton" name="clear_button">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Reset</string></property>
       <property name="toolTip"><string>Put every setting on this page back to its default. In global settings this also empties the game folder list.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="settings_button">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Game Configs</string></property>
       <property name="toolTip"><string>Import or export game configs</string></property>
      </widget>
     </item>
     <item>
      <spacer name="buttonSpacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="cancel_button">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Cancel</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="ok_button">
       <property name="minimumSize"><size><width>80</width><height>25</height></size></property>
       <property name="text"><string>Save</string></property>
       <property name="default"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>MandatoryLineEdit</class>
   <extends>QLineEdit</extends>
   <header>mandatoryLineEdit.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
</ui>
